# Server Configuration
PORT=5002

# MongoDB Configuration
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.mongodb.net/<db_name>?retryWrites=true&w=majority

# Groq AI Configuration
GROQ_API_KEY=your_groq_api_key

# Email Configuration (Nodemailer)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS="your_app_password"
ADMIN_EMAIL=admin_email@gmail.com

# Application URLs
APP_URL=http://localhost:5173
BACKEND_URL=http://localhost:5002

# Rate Limiting Configuration (Tiered & Configurable)
# 1. Authentication Routes (Per-IP & Per-Account + Exponential Backoff)
RATE_LIMIT_AUTH_IP_WINDOW_MS=900000          # 15 minutes (in ms)
RATE_LIMIT_AUTH_IP_MAX=10                    # 10 requests max per IP per window
RATE_LIMIT_AUTH_ACCOUNT_WINDOW_MS=900000     # 15 minutes (in ms)
RATE_LIMIT_AUTH_ACCOUNT_MAX=5                # 5 attempts max per account per window
RATE_LIMIT_AUTH_BACKOFF_BASE_MS=1000         # 1 second initial exponential delay
RATE_LIMIT_AUTH_BACKOFF_FACTOR=2             # Exponential growth factor
RATE_LIMIT_AUTH_MAX_DELAY_MS=30000           # 30 seconds max backoff delay

# 2. Public Routes (Moderate Limits)
RATE_LIMIT_PUBLIC_WINDOW_MS=900000           # 15 minutes (in ms)
RATE_LIMIT_PUBLIC_MAX=100                    # 100 requests max per IP per window

# 3. Authenticated Feature Routes (Looser Limits)
RATE_LIMIT_AUTHENTICATED_WINDOW_MS=900000    # 15 minutes (in ms)
RATE_LIMIT_AUTHENTICATED_MAX=500             # 500 requests max per user per window
